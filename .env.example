APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://olimora:olimora-local-dev@localhost:5432/olimora
EPHEMERIS_PATH=ephe
APP_VERSION=0.1.0
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
AUTH_TOKEN_DAYS=30

# İsteğe bağlıdır. Gerçek anahtarınızı yalnızca `.env` dosyasına yazın.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# E-posta doğrulama ve şifre yenileme için isteğe bağlı SMTP ayarları.
# Parolayı yalnızca yerel `.env` veya Railway Variables içinde saklayın.
PUBLIC_BASE_URL=http://127.0.0.1:8000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
BREVO_API_KEY=
